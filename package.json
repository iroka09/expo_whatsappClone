{
  "name": "myapp",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "list-routes": "npx expo-router-sitemap",
    "eas:build:apk": "EAS_SKIP_AUTO_FINGERPRINT=1 eas build --platform android --profile apk",
    "eas:build:aab": "EAS_SKIP_AUTO_FINGERPRINT=1 eas build --platform android --profile production",
    "eas:build:dev": "EAS_SKIP_AUTO_FINGERPRINT=1 eas build --platform android --profile development",
    "export:web": "npx expo export --platform web",
    "check-unused-libs": "npx depcheck",
    "compress-asset": "npx expo-optimize"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.6",
    "@notifee/react-native": "^9.1.8",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-picker/picker": "2.11.1",
    "@react-navigation/native": "^7.1.8",
    "@reduxjs/toolkit": "^2.9.0",
    "eas-build-cache-provider": "^16.4.2",
    "expo": "~54.0.13",
    "expo-asset": "~12.0.10",
    "expo-constants": "~18.0.10",
    "expo-contacts": "~15.0.10",
    "expo-dev-client": "~6.0.20",
    "expo-device": "~8.0.9",
    "expo-document-picker": "~14.0.7",
