{
  "expo": {
    "jsEngine": "jsc",
    "name": "WhatsApp-Clone",
    "slug": "whatsapp-clone",
    "owner": "iroka09",
    "version": "2.1.8",
    "icon": "./assets/images/ic_launcher_foreground.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#fff",
      "image": "./assets/images/empty_splash_image.png"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.iroka09.whatsappClone"
    },
    "scheme": "wclone",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/ic_launcher_foreground.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.iroka09.whatsapp_clone",
      "intentFilters": [
        {
          "autoVerify": true,
          "action": "VIEW",
          "data": [
            {
              "scheme": "wclone",
              "host": "home"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      // "@notifee/react-native",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/LC.png",
          "color": "#ffffff",
          "defaultChannel": "default",
          "sounds": [
            "./assets/sounds/mixkit_software_interface_remove.wav"
          ],
          "enableBackgroundRemoteNotifications": false
        }
      ],
       [
        "expo-asset",
        {
          "assets": [
            "./assets/images/me.jpg"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "buildCacheProvider": "eas"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5388ec0d-6c69-4332-8b1d-1c4a4cb74dd3"
      }
    }
  }
}